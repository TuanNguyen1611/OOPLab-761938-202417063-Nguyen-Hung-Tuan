<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="768.0" prefWidth="1024.0"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml">

    <top>
        <HBox alignment="CENTER" prefHeight="100.0">
            <padding>
                <Insets left="20.0" right="20.0"/>
            </padding>

            <Label text="Cart" style="-fx-font-size: 50px; -fx-text-fill: #004cff;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="View Store" prefWidth="100.0" prefHeight="50.0" onAction="#btnViewStorePressed"/>
        </HBox>
    </top>

    <center>
        <VBox alignment="CENTER">
            <padding>
                <Insets left="20.0" right="20.0"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="10.0">
                <padding>
                    <Insets top="10.0" bottom="10.0"/>
                </padding>

                <Label text="Filter"/>
                <TextField fx:id="tfFilter"/>
                <RadioButton fx:id="radioBtnFilterId" text="By ID" selected="true"/>
                <RadioButton fx:id="radioBtnFilterTitle" text="By Title"/>
            </HBox>

            <TableView fx:id="tblMedia" prefHeight="450.0">
                <columns>
                    <TableColumn fx:id="colMediaId" text="ID"/>
                    <TableColumn fx:id="colMediaTitle" text="Title" prefWidth="400"/>
                    <TableColumn fx:id="colMediaCategory" text="Category" prefWidth="200"/>
                    <TableColumn fx:id="colMediaCost" text="Cost"/>
                </columns>
            </TableView>

            <HBox alignment="TOP_RIGHT" spacing="20.0">
                <padding>
                    <Insets top="10.0"/>
                </padding>

                <Button fx:id="btnPlay" text="Play" prefWidth="60.0" onAction="#btnPlayPressed"/>
                <Button fx:id="btnRemove" text="Remove" prefWidth="80.0" onAction="#btnRemovePressed"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <VBox alignment="TOP_CENTER" spacing="30.0" prefHeight="200.0">
            <HBox alignment="CENTER" spacing="10.0">
                <Label text="Total:" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                <Label fx:id="costLabel" text="0 $" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
            </HBox>

            <Button text="Place Order"
                    style="-fx-background-color: #004cff; -fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;"
                    onAction="#btnPlaceOrderPressed"/>
        </VBox>
    </bottom>

</BorderPane>